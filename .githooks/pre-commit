#!/bin/sh
#
# Archivo: herramientas/hooks/pre-commit
# Objetivo: Impedir que un secreto ENTRE al repositorio, no detectarlo despues.
# Proyecto: herramienta generica del manual de ingenieria (etmunoz/ingenieria)
# Entorno: POSIX sh — corre igual en Linux, macOS y Windows (Git Bash).
#
# POR QUE EXISTE
# --------------
# Un escaner de secretos en CI encuentra el secreto **cuando ya entro al
# historial**, y entonces hay que rotarlo aunque se borre en el commit
# siguiente: git no olvida, y el repositorio puede haberse clonado en el medio.
#
#   CI    -> "entro un secreto al historial". Encuentra, y ya es tarde.
#   Hook  -> "este commit trae un secreto". Impide, que es lo que sirve.
#
# No reemplaza a CI: hace algo distinto y complementario.
#
# INSTALACION
#     git config core.hooksPath <carpeta-donde-copiaste-los-hooks>
#
# Se versiona el hook y se apunta `core.hooksPath` en vez de copiarlo a
# `.git/hooks/`: asi vive en el repositorio, se revisa como codigo, y no hay que
# acordarse de re-copiarlo despues de cada clon.
#
# DOS MOTORES, EN ORDEN DE PREFERENCIA
# ------------------------------------
#   1. gitleaks en Docker, si hay Docker. Reglas mantenidas por terceros.
#   2. revisar_secretos.py (herramientas/seguridad/), si no. Python puro, sin
#      dependencias, y por eso corre donde el primero no.
#
# Se declara con la variable RUTA_REVISAR_SECRETOS donde quedo el script; si no
# se declara, se busca junto a este hook y en las rutas habituales.
#
# TRES DEFECTOS QUE SOLO APARECIERON AL PROBARLO CON UNA CLAVE DE VERDAD
# ----------------------------------------------------------------------
# La primera version se escribio, se instalo, y **commiteo el secreto sin
# chistar**. Tres causas encadenadas, en orden de descubrimiento:
#
#   1. Git Bash en Windows convierte `-w /repo` a una ruta de Windows y docker
#      falla con "the working directory ... is invalid". Se resuelve con
#      MSYS_NO_PATHCONV=1 y `//repo`.
#   2. El codigo de salida se leia con `$?` dentro de un `if`, donde vale el
#      resultado de evaluar la condicion: siempre 0.
#   3. **El peor de los tres:** se usaba un subcomando que desaparecio en
#      gitleaks v8. La version actual lo acepta SIN ERROR, escanea 0 commits e
#      informa "no leaks found" sobre un secreto que esta ahi. La herramienta
#      corria bien, el hook decia "sin secretos", y la clave entraba.
#
# La leccion, y por eso esta escrita aca: **un hook de seguridad se prueba
# intentando commitear un secreto, no leyendolo.** Las tres veces que fallo, el
# archivo se veia correcto.
#
# POR QUE NO ABORTA SI NO HAY NINGUN MOTOR
# ----------------------------------------
# Avisa y deja pasar. Un hook que bloquea todo commit en una maquina donde falta
# una herramienta se desinstala el mismo dia, y entonces no protege nunca. CI
# sigue siendo la red que no se puede desactivar. Pero lo dice fuerte: un
# chequeo que no pudo correr responde "no se", nunca verde.

VERDE='\033[0;32m'
ROJO='\033[0;31m'
AMARILLO='\033[0;33m'
FIN='\033[0m'

# Sin nada preparado no hay nada que revisar.
if git diff --cached --quiet 2>/dev/null; then
    exit 0
fi

# --- Motor 2: localizar el escaner en Python ---------------------------------
buscar_revisor() {
    if [ -n "${RUTA_REVISAR_SECRETOS:-}" ] && [ -f "$RUTA_REVISAR_SECRETOS" ]; then
        printf '%s' "$RUTA_REVISAR_SECRETOS"; return 0
    fi
    dir_hook=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    for cand in \
        "$dir_hook/../seguridad/revisar_secretos.py" \
        "$dir_hook/revisar_secretos.py" \
        "$(git rev-parse --show-toplevel 2>/dev/null)/herramientas/seguridad/revisar_secretos.py" \
        "$(git rev-parse --show-toplevel 2>/dev/null)/scripts/revisar_secretos.py"
    do
        [ -f "$cand" ] && { printf '%s' "$cand"; return 0; }
    done
    return 1
}

interprete_python() {
    # El interprete se PRUEBA, no se pregunta si esta.
    #
    # Esto decia `command -v "$py"`, y es un falso positivo con nombre propio:
    # en Windows, `python` y `python3` estan en el PATH como alias de la
    # Microsoft Store que **fallan al ejecutarse**. `command -v` los encuentra,
    # el hook los da por buenos, y el escaneo de secretos no corre --- sin que
    # nada lo avise. Correr `-c ""` cuesta milisegundos y es la diferencia
    # entre "esta instalado" y "funciona".
    #
    # Se acepta tambien una ruta declarada por quien clona, para el caso comun
    # de un interprete que no esta en el PATH:
    #     git config --local ingenieria.python <ruta>
    for py in "$INGENIERIA_PYTHON" "$(git config --get ingenieria.python 2>/dev/null)" python3 python py; do
        [ -z "$py" ] && continue
        "$py" -c "" 2>/dev/null || continue
        printf '%s' "$py"
        return 0
    done
    return 1
}

printf "[pre-commit] Buscando secretos en lo que se va a commitear...\n"

# ============================================================================
# LOS MOTORES CORREN TODOS, NO EL PRIMERO QUE ESTE (R-11)
# ============================================================================
# Antes esto era una cadena: si gitleaks estaba, decidia solo; el revisor local
# era el suplente. Y **los dos no ignoran lo mismo**.
#
# El caso que lo destapo: la clave de ejemplo de un proveedor de nube --la que
# figura en su documentacion-- PASA por gitleaks, que la tiene en su lista de
# excepciones, y la MARCA el revisor local. Con la cadena, dos maquinas del
# mismo equipo tenian proteccion distinta segun tuvieran Docker o no, y nada
# lo decia.
#
# Ahora corren los que esten, y frena si CUALQUIERA encuentra algo. Cuesta
# segundos. Un hook de secretos es exactamente donde conviene pagarlos.
#
# Y el informe dice QUE MOTORES CORRIERON: un verde que no dice sobre que es
# una afirmacion sobre el repositorio que la corrida no respalda.
# ============================================================================

CORRIERON=""
AUSENTES=""
HALLAZGO=0

# --- Motor 1: gitleaks en contenedor -----------------------------------------
if command -v docker >/dev/null 2>&1; then
    # El reporte va a un archivo NUEVO en cada corrida. Reutilizar uno fijo hacia
    # que, si docker fallaba, el hook leyera el resultado de la corrida anterior
    # y decidiera con datos viejos -- paso mientras se depuraba esto.
    REPORTE=$(mktemp 2>/dev/null || echo "/tmp/gitleaks_precommit.$$.log")

    MSYS_NO_PATHCONV=1 docker run --rm -v "$(pwd):/repo" -w //repo \
        zricethezav/gitleaks:latest git --staged --redact --no-banner \
        >"$REPORTE" 2>&1

    # Se decide leyendo la SALIDA y no el codigo de retorno: docker devuelve 0
    # aunque gitleaks encuentre algo.
    if grep -qi "leaks found" "$REPORTE" 2>/dev/null && ! grep -qi "no leaks found" "$REPORTE" 2>/dev/null; then
        printf "\n${ROJO}[pre-commit] gitleaks encontro un secreto.${FIN}\n"
        tail -30 "$REPORTE" 2>/dev/null
        HALLAZGO=1
        CORRIERON="$CORRIERON gitleaks"
    elif grep -qi "no leaks found" "$REPORTE" 2>/dev/null; then
        CORRIERON="$CORRIERON gitleaks"
    else
        printf "${AMARILLO}[pre-commit] gitleaks no pudo ejecutarse.${FIN}\n"
        tail -3 "$REPORTE" 2>/dev/null
        AUSENTES="$AUSENTES gitleaks(fallo)"
    fi
    rm -f "$REPORTE"
else
    AUSENTES="$AUSENTES gitleaks(sin-docker)"
fi

# --- Motor 2: el revisor propio ----------------------------------------------
REVISOR=$(buscar_revisor) || REVISOR=""
PY=$(interprete_python) || PY=""

if [ -n "$REVISOR" ] && [ -n "$PY" ]; then
    if "$PY" "$REVISOR"; then
        CORRIERON="$CORRIERON revisor-local"
    else
        printf "\n${ROJO}[pre-commit] El revisor local encontro un secreto.${FIN}\n"
        HALLAZGO=1
        CORRIERON="$CORRIERON revisor-local"
    fi
elif [ -z "$REVISOR" ]; then
    AUSENTES="$AUSENTES revisor-local(no-encontrado)"
else
    AUSENTES="$AUSENTES revisor-local(sin-python)"
fi

# --- El veredicto, con la cifra ----------------------------------------------
if [ "$HALLAZGO" = "1" ]; then
    printf "\n${ROJO}[pre-commit] SECRETO DETECTADO. El commit se detuvo.${FIN}\n"
    printf "            Motores que corrieron:%s\n" "${CORRIERON:- ninguno}"
    cat <<'AYUDA'

Que hacer:

  1. Sacar el secreto del codigo. Si es configuracion, va al archivo de entorno
     que esta ignorado por git.
  2. Si el valor YA se uso alguna vez, ROTARLO igual. Que no haya entrado al
     historial no significa que no se haya filtrado por otra via.
  3. Si es un SENUELO -- un valor falso que existe para probar un detector --
     declararlo en la lista de excepciones de la herramienta, nunca silenciar
     el hook entero.

Para saltarlo en un caso justificado (y sabiendo lo que se hace):

    git commit --no-verify

AYUDA
    exit 1
fi

if [ -n "$CORRIERON" ]; then
    printf "${VERDE}[pre-commit] Sin secretos.${FIN} Motores:%s\n" "$CORRIERON"
    [ -n "$AUSENTES" ] && printf "${AMARILLO}            NO corrieron:%s -- el verde es sobre los que si.${FIN}\n" "$AUSENTES"
    exit 0
fi

printf "${AMARILLO}[pre-commit] Ningun motor disponible: NO se revisaron secretos.${FIN}\n"
printf "            Esto es un \"no se\", no un verde. Instala Docker, o deja\n"
printf "            revisar_secretos.py accesible y declara RUTA_REVISAR_SECRETOS.\n"
exit 0
